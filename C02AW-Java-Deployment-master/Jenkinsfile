pipeline {
    agent {
        label 'jenkins-agent-1'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Maven Build') {
            steps {
                dir('C02AW-Java-Deployment-master') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Verify WAR') {
            steps {
                dir('C02AW-Java-Deployment-master') {
                    sh 'ls -lh target/sample.war'
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                dir('C02AW-Java-Deployment-master') {
                    sh "docker build -t sample-app:${BUILD_NUMBER} ."
                }
            }
        }

        stage('Stop Old Container') {
            steps {
                sh 'docker rm -f sample-app || true'
            }
        }

        stage('Deploy Docker Container') {
            steps {
                sh """
                    docker run -d \
                    --name sample-app \
                    -p 8081:8080 \
                    sample-app:${BUILD_NUMBER}
                """
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    i=1

                    while [ "$i" -le 10 ]; do

                        if curl -fsSL http://localhost:8081/sample/ -o /dev/null; then
                            echo "Application is healthy!"
                            exit 0
                        fi

                        echo "Waiting for application startup..."
                        sleep 5

                        i=$((i + 1))
                    done

                    echo "Application health check failed!"
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            echo 'DOCKER BUILD AND DEPLOYMENT SUCCESSFUL!'
        }

        failure {
            echo 'DOCKER BUILD OR DEPLOYMENT FAILED!'
        }
    }
}
