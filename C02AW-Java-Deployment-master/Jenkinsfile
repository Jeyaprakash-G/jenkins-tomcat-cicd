pipeline {
    agent {
        label 'jenkins-agent-1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Maven Build') {
            steps {
                dir('C02AW-Java-Deployment-master') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Verify WAR') {
            steps {
                dir('C02AW-Java-Deployment-master') {
                    sh 'ls -lh target/sample.war'
                }
            }
        }

        stage('Deploy to Tomcat') {
            steps {
                dir('C02AW-Java-Deployment-master') {
                    sh 'cp target/sample.war /opt/tomcat/webapps/sample.war'
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sh 'sleep 15'
                sh 'curl -f http://localhost:8080/sample/'
            }
        }
    }

    post {
        success {
            echo 'BUILD AND DEPLOYMENT SUCCESSFUL!'
        }
        failure {
            echo 'BUILD OR DEPLOYMENT FAILED!'
        }
    }
}
